# Plantilla de variables de entorno para el pipeline de ingesta
# Open Brewery DB -> BigQuery.
#
# Copia este archivo como `.env` y completa los valores necesarios.
# Nunca incluyas secretos reales en este archivo de ejemplo.

# ---------------------------------------------------------------
# BigQuery (carga)
# ---------------------------------------------------------------
# Proyecto de GCP destino. OBLIGATORIO para ejecutar la carga real.
BQ_PROJECT=

# Dataset destino (capa bronze / sandbox). Por defecto: SANDBOX_alten_pipeline
# BQ_DATASET=SANDBOX_alten_pipeline

# Tabla destino de los registros crudos. Por defecto: raw_breweries
# BQ_TABLE=raw_breweries

# Ubicacion geografica del dataset. Por defecto: US
# BQ_LOCATION=US

# ---------------------------------------------------------------
# API de Open Brewery DB (descarga)
# ---------------------------------------------------------------
# URL base del endpoint. Por defecto: la oficial.
# API_BASE_URL=https://api.openbrewerydb.org/v1/breweries

# Registros por pagina (maximo 200 en la API). Por defecto: 50
# API_PER_PAGE=50

# Timeout HTTP por solicitud, en segundos. Por defecto: 30
# API_TIMEOUT_SECONDS=30

# Reintentos ante errores transitorios (5xx, 429, timeout). Por defecto: 3
# API_MAX_RETRIES=3

# ---------------------------------------------------------------
# Ejecucion
# ---------------------------------------------------------------
# Nivel de logging. Por defecto: INFO
# LOG_LEVEL=INFO
