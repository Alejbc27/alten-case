# ---------------------------------------------------------------
# Credenciales y secretos
# ---------------------------------------------------------------
# Cuidado: NO usar un "*.json" global porque romperia configs utiles.
# Se ignoran patrones especificos de credenciales de servicio.
*-credentials.json
*-credential.json
service-account*.json
service_account*.json
gcp-*.json
google-*.json
*sa-key*.json
*-sa.json
# Directorio de claves generado por Terraform (local_sensitive_file).
.secrets/
secrets/
.env
.env.*
!.env.example

# ---------------------------------------------------------------
# Terraform
# ---------------------------------------------------------------
# Estado y planes locales NUNCA se versionan (pueden contener secretos)
**/terraform.tfstate
**/terraform.tfstate.*
**/*.tfstate
**/*.tfstate.*
.terraform/
*.tfplan
crash.log
crash.*.log

# Variables locales de Terraform (suelen contener secretos)
*.tfvars
!*.tfvars.example
terraform.tfvars
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# ---------------------------------------------------------------
# Airflow
# ---------------------------------------------------------------
airflow.db
airflow-webserver.pid
unittests.cfg
.logs/

# ---------------------------------------------------------------
# Logs
# ---------------------------------------------------------------
logs/
*.log

# ---------------------------------------------------------------
# IDE / editores
# ---------------------------------------------------------------
.idea/
.vscode/
*.swp
*.swo

# ---------------------------------------------------------------
# Datos locales (no versionar datos reales de la prueba)
# ---------------------------------------------------------------
data/raw/
data/processed/
*.csv
*.parquet
*.jsonl
!tests/**/*.csv
!tests/**/*.jsonl
