# Non-sensitive example values. Copy to terraform.tfvars (git-ignored) and edit.
# No secrets here: the GCS backend bucket/prefix are passed via -backend-config
# at `terraform init`, and the SA key is generated by `terraform apply`.

gcp_project        = "alten-case"
gcp_region         = "europe-west1"
sa_account_id      = "alten-pipeline-sa"
sa_key_output_path = "../.secrets/alten-pipeline-sa.json"

# Documented backend bucket (also pass the same value to -backend-config=...).
gcs_bucket = "REPLACE_WITH_YOUR_GCS_BUCKET"

dataset_names = {
  sandbox     = "SANDBOX_alten_pipeline"
  integration = "INTEGRATION"
}

table_names = {
  raw_breweries              = "raw_breweries"
  integration_prueba_tecnica = "integration_prueba_tecnica"
}
