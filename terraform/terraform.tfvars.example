# Valores de ejemplo no sensibles. Copia a terraform.tfvars (ignorado por git)
# y edita. Sin secretos aqui: el bucket/prefijo del backend GCS se pasan via
# -backend-config en `terraform init`.

gcp_project   = "alten-case"
gcp_region    = "europe-west1"
sa_account_id = "bq-alten-case"

# Por defecto NO se crea ninguna Service Account Key: se asume un JSON existente
# (descargado desde la consola) o Application Default Credentials. Si queres que
# Terraform genere una clave nueva (la clave privada queda en el state),
# poni create_sa_key = true y descomenta sa_key_output_path.
create_sa_key = false
# sa_key_output_path = "../.secrets/alten-pipeline-sa.json"

# Backend documentado (pasa tambien el mismo valor a -backend-config=...).
gcs_bucket = "REPLACE_WITH_YOUR_GCS_BUCKET"

dataset_names = {
  sandbox     = "SANDBOX_alten_pipeline"
  integration = "INTEGRATION"
}

table_names = {
  raw_breweries              = "raw_breweries"
  integration_prueba_tecnica = "integration_prueba_tecnica"
}
